# ============================================================
# AI Medical Agent - Environment Variables Template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real API keys in .env
# 3. NEVER commit .env to version control
# ============================================================

# ---------------------------
# LLM API Keys (choose one)
# ---------------------------

# Groq (recommended - fast & free tier available)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (optional fallback)
# Get key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (optional)
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------
# Observability (optional)
# ---------------------------

# LangSmith tracing - https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai-medical-agent

# ---------------------------
# App Settings (override config.yaml)
# ---------------------------

# LLM model (overrides config.yaml if set)
# LLM_MODEL=llama-3.1-8b-instant

# ChromaDB persistence directory
# CHROMA_PERSIST_DIR=./chroma_medical_db

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
